# Always required: Gemini does image/vision parsing regardless of AI_PROVIDER.
GEMINI_API_KEY=

# Only needed if AI_PROVIDER is explicitly set away from "bedrock" (see below) —
# text parsing/shopping-list consolidation are Bedrock-only now; embeddings can
# still opt out to OpenAI's text-embedding-3-small.
OPENAI_API_KEY=

# AI_PROVIDER defaults to "bedrock" if unset. Set to "gemini"/"openai" to opt
# embeddings back onto OpenAI. Requires AWS credentials available to boto3
# (env vars, shared config/SSO profile, or an instance/task role) — not listed
# here since boto3 resolves them itself.
AI_PROVIDER=bedrock
AWS_REGION=eu-west-1

POSTGRES_USER=recipe_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scrappy_recipes

APP_API_KEY=local_dev_secret_key_123
